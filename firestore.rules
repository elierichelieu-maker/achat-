rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Products collection (Catalogue boissons & stocks)
    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId);
    }

    // Sellers collection (Commerciaux)
    match /sellers/{sellerId} {
      allow read: if true;
      allow write: if isValidId(sellerId);
    }

    // Customers collection (Clients CHR)
    match /customers/{customerId} {
      allow read: if true;
      allow write: if isValidId(customerId);
    }

    // Sales collection (Ventes & Factures)
    match /sales/{saleId} {
      allow read: if true;
      allow write: if isValidId(saleId);
    }

    // Movements collection (Mouvements de stock)
    match /movements/{movementId} {
      allow read: if true;
      allow write: if isValidId(movementId);
    }

    // Settings collection (Paramètres généraux)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Exchange rates collection
    match /exchange_rates/{rateId} {
      allow read: if true;
      allow write: if isValidId(rateId);
    }

    // Exchange transactions collection
    match /exchange_transactions/{transactionId} {
      allow read: if true;
      allow write: if isValidId(transactionId);
    }
    // Test collection for connection health checks
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
